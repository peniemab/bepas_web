# Modèle pour .env — ne pas y mettre de vraies clés dans git
# Copier vers .env ou .env.local et remplir

# URL publique du site (SEO : canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.bepas-sarl.com

NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co

# Clé "anon" (publique) du projet Supabase — PAS la clé service_role.
# Lue uniquement côté serveur ; l'accès est limité par les policies RLS.
SUPABASE_ANON_KEY=
